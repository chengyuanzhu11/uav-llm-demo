UAV_LLM_BACKEND=deepseek
DEEPSEEK_API_KEY=<your_deepseek_api_key>
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Onboard vision uses the same endpoint/key only when that endpoint supports images.
# Bailian defaults to qwen3-vl-plus; other providers require an explicit vision model.
# VISION_MODEL=qwen3-vl-plus
# For a separate vision provider, set BOTH endpoint and its own key:
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=<your_vision_provider_api_key>
