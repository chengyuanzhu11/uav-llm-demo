UAV_LLM_BACKEND=deepseek
DEEPSEEK_API_KEY=<your_deepseek_api_key>
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# AirSim defaults to the Windows WSL gateway (or localhost in mirrored mode).
# AIRSIM_HOST=172.25.16.1
# AIRSIM_PORT=41451
# AIRSIM_VEHICLE_NAME=Drone1
# AIRSIM_TEXTURE_DIR=/mnt/c/Users/<Windows-user>/AppData/Local/UAV_LLM/AirSim/textures
