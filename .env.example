# Generic task planner. Self-hosted Qwen can handle language planning and vision.
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
LLM_BASE_URL=http://127.0.0.1:8004/v1
# vLLM: constrain task output to the published schema; application checks still apply.
LLM_TASK_RESPONSE_FORMAT=json_schema
# High-level request wait; not a flight-control or total task timeout.
LLM_REQUEST_TIMEOUT_SECONDS=90
# direct: one vision model reads RGB and feedback and chooses a tool.
# two_stage remains supported: image perception followed by language decisions.
VISION_STRATEGY=direct
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
VISION_BASE_URL=http://127.0.0.1:8004/v1
# Loopback endpoints may omit their API key (e.g. the SSH tunnel).
# Independent external HTTPS endpoints require their own credentials.
VISION_API_KEY=
# LLM_* takes precedence as one complete profile; DEEPSEEK_* remains supported
# only when no LLM_* variable is present, without mixing credentials.
